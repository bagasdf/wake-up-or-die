{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wuod-be",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "minify": true,
  "keep_vars": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  "vars": {
    "APP_NAME": "Website Edukasi Anti Narkoba",
    "BETTER_AUTH_URL": "https://wuod.hexaa.sh/api/auth",
    "CHAT_API_ORIGIN": "https://wuod-api.hexagonn.my.id",
    "OPENAI_COMPATIBLE_BASE_URL": "https://openrouter.ai/api/v1",
    "OPENAI_COMPATIBLE_MODEL": "nvidia/nemotron-3-ultra-550b-a55b:free",
    "SEED_ADMIN_EMAIL": "admin@wuod.local",
    "SEED_ADMIN_NAME": "Administrator WUOD",
    "SERVER_API_URL": "/api",
    "WEB_ORIGIN": "https://wuod.hexaa.sh",
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "wuod-media",
      "preview_bucket_name": "wuod-media-dev",
    },
  ],
}
